{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "envFile": "${workspaceFolder}/.env.dev",
            "env": {
                "DULY_SERVICE_URI": "http://localhost:5001/api"
            },
            "args": [
                "src.app:app",
                "--port",
                "8000"
            ]
        }
    ]
}
